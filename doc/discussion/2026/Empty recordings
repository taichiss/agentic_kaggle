Yes, I resample them at 32khz and convert them to .ogg

def process(idx): filename = df.loc[idx, 'filename'] wav, sr = torchaudio.load(PATH+'train_audio/'+filename) Hash = torch.hash_tensor(wav).numpy() original_length = len(wav[0]) status = 'OK'

target_sr = 32000
if wav.size(1) < target_sr * 2:  
    try:
        r = requests.get(df.loc[idx, 'url'])
        wav, sr = torchaudio.load(r.content)
        wav = torchaudio.functional.resample(wav, orig_freq=sr, new_freq=target_sr)
        wav = wav.mean(dim=0, keepdim=True)
        print(original_length/target_sr, ' -> ', wav.size(1)/target_sr)
    except:
        status = 'FAIL'
Hash = torch.hash_tensor(wav).numpy()
torchaudio.save(PATH+'clean_audio/'+filename, src=wav, sample_rate=target_sr)

return idx, len(wav[0]), original_length, Hash, status

